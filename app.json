{
  "expo": {
    "name": "Tea With God",
    "slug": "twg",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/teacup.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "scheme": "teawithgod",
    "splash": {
      "image": "./assets/teacup.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0D0D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.teawithgod.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/teacup.png",
        "backgroundColor": "#0D0D0D"
      },
      "package": "com.teawithgod.app",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "teawithgod"
            },
            {
              "scheme": "https",
              "host": "twg.cleva-ai.co.za",
              "pathPrefix": "/auth"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/teacup.png",
      "bundler": "metro",
      "name": "Tea With God",
      "shortName": "TWG",
      "description": "A 40-Day Healing Companion for Women",
      "backgroundColor": "#0D0D0D",
      "themeColor": "#D4AF37",
      "display": "standalone",
      "orientation": "portrait",
      "scope": "/",
      "startUrl": "/"
    },
    "extra": {
      "eas": {
        "projectId": "c73bc495-3076-4fa2-8124-8c9e532c385f"
      }
    },
    "owner": "gionarchtects-organization"
  }
}
